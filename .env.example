# EmailJS credentials for the contact form (browser-publishable values).
# Copy to .env.local and fill in from https://dashboard.emailjs.com
#
# The template referenced by VITE_EMAILJS_TEMPLATE_ID must have its
# "To Email" field set (e.g. to {{to_email}} or a literal address) and may use
# any of these variables: {{name}} {{email}} {{reply_to}} {{subject}} {{message}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
